FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04
ENV MLFLOW_DISABLE_TELEMETRY=true MLFLOW_DISABLE_AGENT_HINT=true STREAMLIT_BROWSER_GATHER_USAGE_STATS=false DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 PATH=/opt/venv/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv libgomp1 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
WORKDIR /app
COPY requirements-lock.txt .
RUN pip install --no-cache-dir -r requirements-lock.txt
COPY . .
# CUDA is available to compatible libraries; the bundled LightGBM wheel trains on CPU.
CMD ["python", "-m", "src.train", "--trials", "5"]
